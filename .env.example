# Telegram Bot Token (отримайте у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID адміністраторів через кому (дізнатися свій ID можна у @userinfobot)
ADMIN_IDS=123456789

# Зовнішній HTTPS URL для Telegram Mini App (для тестування можна використовувати ngrok або cloudflare tunnel)
WEBAPP_URL=https://your-domain-or-ngrok.app

# Локалізація (Тільки Україна)
TIMEZONE=Europe/Kyiv
CURRENCY=₴

# База даних (PostgreSQL)
# Формат: postgresql+asyncpg://користувач:пароль@хост:порт/назва_бд
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mtservice

# Кеш Redis
REDIS_URL=redis://localhost:6379/0

# Веб-сервер Mini App (FastAPI)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Початкові параметри генератора (використовуються при першій ініціалізації)
GENERATOR_NAME=Основний ДГУ
INITIAL_TOTAL_HOURS=0.0
FUEL_RATE_PER_HOUR=4.5
TANK_CAPACITY=150.0
INITIAL_FUEL_LEVEL=100.0
MAINTENANCE_INTERVAL_HOURS=250.0
MAINTENANCE_WARNING_HOURS=20.0
