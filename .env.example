# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=123456789,987654321

# Часовой пояс объекта (например, Europe/Moscow, Asia/Yekaterinburg, Asia/Almaty)
TIMEZONE=Europe/Moscow

# Путь к базе данных SQLite
DATABASE_URL=sqlite+aiosqlite:///data/generator.db

# Начальные параметры генератора (используются при первой инициализации)
GENERATOR_NAME=Основной ДГУ
INITIAL_TOTAL_HOURS=0.0
FUEL_RATE_PER_HOUR=4.5
TANK_CAPACITY=150.0
INITIAL_FUEL_LEVEL=100.0
MAINTENANCE_INTERVAL_HOURS=250.0
MAINTENANCE_WARNING_HOURS=20.0
